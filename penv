#!/usr/bin/env bash
SCRIPT_PATH=$(realpath "$0")
SCRIPT_DIR=$(dirname "${SCRIPT_PATH}")
SCRIPT_NAME=$(basename "${SCRIPT_PATH}")

# Version information — sourced from VERSION file if present
VERSION_FILE="${SCRIPT_DIR}/VERSION"
if [[ -f "$VERSION_FILE" ]]; then
    VERSION=$(cat "$VERSION_FILE")
else
    VERSION="0.1.2"
fi

# Unified error handler
die() {
    echo "Error: $*" >&2
    exit 1
}

function usage()
{
    echo "Usage: ${SCRIPT_NAME} cmd [params]"
    echo ""
    echo "Python virtual environment management tool."
    echo ""
    echo "Commands:"
    echo "  create        Creates a new virtual environment."
    echo "                Usage: penv create <env_name> [description]"
    echo "  list          Lists all virtual environments."
    echo "                Usage: penv list [--sort-by=name|date]"
    echo "  remove        Removes a virtual environment."
                echo "                Usage: penv remove [env_name]"
    echo "  activate      Activates a virtual environment."
                echo "                Usage: penv activate [env_name]"
    echo "  show          Show active virtual environments."
    echo "                Usage: penv show"
    echo "  deactivate    Deactivates the current virtual environment."
    echo "                Usage: penv deactivate"
    echo "  clean         Deactivates all virtual environments."
    echo "                Usage: penv clean"
    echo "  clone         Clones a virtual environment to a new one."
    echo "                Usage: penv clone <source_env> <dest_env> [description]"
    echo "  requirements  Export/import requirements for an environment."
    echo "                Usage: penv requirements <env_name> <export|import> [file]"
    echo "  project       Bind projects to virtual environments."
                echo "                Usage: penv project <bind|unbind|show|list> [--direnv]"
    echo "  usage         Show disk usage of virtual environments."
    echo "                Usage: penv usage [--sort-by=size|name]"
    echo "  info          Show detailed information about an environment."
    echo "                Usage: penv info <env_name>"
    echo "  config        Manage penv configuration."
    echo "                Usage: penv config [list|get|set]"
  echo "  rename        Rename a virtual environment."
                echo "                Usage: penv rename <old_name> <new_name>"
                echo "  doctor        Diagnose penv system health."
                echo "                Usage: penv doctor"
                echo "  prune         Remove broken virtual environments."
                echo "                Usage: penv prune [--force]"
                echo "  plugin        List installed plugins."
                echo "                Usage: penv plugin [list]"
                echo "  help, -h, --help    Displays this help message."
    echo "                Usage: penv help [command]"
    echo "  --version     Display version information."
    echo ""
    echo "Examples:"
    echo "  penv create myproject \"My Python project\""
    echo "  penv list"
    echo "  penv list --sort-by=date"
    echo "  penv activate myproject"
    echo "  penv deactivate"
    echo "  penv remove myproject"
    echo "  penv clone myproject newproject \"New project based on myproject\""
    echo "  penv requirements myproject export requirements.txt"
    echo "  penv requirements myproject import requirements.txt"
    echo "  penv project bind myproject"
    echo "  penv project bind myproject --direnv"
    echo "  penv usage --sort-by=size"
    echo "  penv info myproject"
    echo "  penv config set default_python python3.11"
    echo "  penv config list"
    echo "  penv rename myproject myproject2"
    echo "  penv doctor"
    echo "  penv prune"
    echo "  penv plugin list"
    echo ""
    echo "For command-specific help, use: penv help <command>"
    exit 1
}

function version()
{
    echo "${SCRIPT_NAME} version ${VERSION}"
    exit 0
}

function command_help()
{
    if [ $# -eq 0 ]; then
        usage
        return
    fi

    local cmd=$1
    case "$cmd" in
        create)
            echo "Usage: penv create <env_name> [description]"
            echo ""
            echo "Creates a new Python virtual environment."
            echo ""
            echo "Arguments:"
            echo "  env_name      Name of the virtual environment to create"
            echo "  description   Optional description for the environment"
            echo ""
            echo "Example:"
            echo "  penv create myproject \"My Python project\""
            ;;
        list)
            echo "Usage: penv list [--sort-by=name|date] [--filter=pattern]"
            echo ""
            echo "Lists all Python virtual environments."
            echo ""
            echo "Options:"
            echo "  --sort-by=name|date   Sort environments by name (default) or creation date"
            echo "  --filter=pattern      Filter environments by name pattern"
            echo ""
            echo "Examples:"
            echo "  penv list"
            echo "  penv list --sort-by=date"
            echo "  penv list --filter=test"
            ;;
        remove)
            echo "Usage: penv remove [env_name]"
            echo ""
            echo "Removes a Python virtual environment."
            echo ""
            echo "Arguments:"
            echo "  env_name      Name of the virtual environment to remove"
            echo ""
            echo "If no name is given and fzf is installed, an interactive"
            echo "multi-select picker is shown."
            echo ""
            echo "Examples:"
            echo "  penv remove myproject"
            echo "  penv remove         (fzf multi-select)"
            ;;
        activate)
            echo "Usage: penv activate [env_name]"
            echo ""
            echo "Activates a Python virtual environment."
            echo ""
            echo "Arguments:"
            echo "  env_name      Name of the virtual environment to activate"
            echo ""
            echo "If no name is given and fzf is installed, an interactive"
            echo "picker is shown."
            echo ""
            echo "Examples:"
            echo "  penv activate myproject"
            echo "  penv activate       (fzf picker)"
            ;;
        show)
            echo "Usage: penv show"
            echo ""
            echo "Shows currently active virtual environments."
            echo ""
            echo "Example:"
            echo "  penv show"
            ;;
        deactivate)
            echo "Usage: penv deactivate"
            echo ""
            echo "Deactivates the currently active virtual environment."
            echo ""
            echo "Example:"
            echo "  penv deactivate"
            ;;
        clean)
            echo "Usage: penv clean"
            echo ""
            echo "Deactivates all active virtual environments."
            echo ""
            echo "Example:"
            echo "  penv clean"
            ;;
        clone)
            echo "Usage: penv clone <source_env_name> <dest_env_name> [description]"
            echo ""
            echo "Clones a Python virtual environment to a new one."
            echo ""
            echo "Arguments:"
            echo "  source_env_name    Name of the virtual environment to clone from"
            echo "  dest_env_name      Name of the new virtual environment to create"
            echo "  description        Optional description for the new environment"
            echo ""
            echo "Example:"
            echo "  penv clone myproject newproject \"New project based on myproject\""
            ;;
        requirements)
            echo "Usage: penv requirements <env_name> <export|import> [requirements_file]"
            echo ""
            echo "Export or import Python package requirements for a virtual environment."
            echo ""
            echo "Arguments:"
            echo "  env_name           Name of the virtual environment"
            echo "  operation          'export' to save packages to file, 'import' to install from file"
            echo "  requirements_file  Optional file path for requirements (default: environment's requirements.txt)"
            echo ""
            echo "Examples:"
            echo "  penv requirements myproject export requirements.txt"
            echo "  penv requirements myproject import requirements.txt"
            ;;
        project)
            echo "Usage: penv project <bind|unbind|show|list>"
            echo ""
            echo "Bind projects to virtual environments."
            echo ""
            echo "Operations:"
            echo "  bind <env> [--direnv]  Bind to environment (or generate .envrc)"
            echo "  unbind                 Unbind current directory"
            echo "  show                   Show current directory binding"
            echo "  list                   List all project bindings"
            echo ""
            echo "Use --direnv to generate a .envrc file (direnv-based"
            echo "auto-activation) instead of the default .penv file."
            echo ""
            echo "Examples:"
            echo "  penv project bind myproject"
            echo "  penv project bind myproject --direnv"
            echo "  penv project show"
            echo "  penv project list"
            ;;
        usage)
            echo "Usage: penv usage [--sort-by=size|name]"
            echo ""
            echo "Show disk usage of virtual environments."
            echo ""
            echo "Options:"
            echo "  --sort-by=size|name   Sort environments by size (default) or name"
            echo ""
            echo "Example:"
            echo "  penv usage --sort-by=name"
            ;;
        info)
            echo "Usage: penv info <env_name>"
            echo ""
            echo "Show detailed information about a virtual environment."
            echo ""
            echo "Arguments:"
            echo "  env_name      Name of the virtual environment"
            echo ""
            echo "Output includes: Python version, path, disk usage,"
            echo "package count, creation date, and activation status."
            echo ""
            echo "Example:"
            echo "  penv info myproject"
            ;;
        config)
            echo "Usage: penv config [list|get|set]"
            echo ""
            echo "Manage penv configuration."
            echo ""
            echo "Operations:"
            echo "  list          List all configuration settings"
            echo "  get <key>     Get a configuration value"
            echo "  set <key> <value>  Set a configuration value"
            echo ""
            echo "Settings:"
            echo "  default_python    Default Python executable for 'penv create'"
            echo "  storage_dir       Override the virtual environment storage directory"
            echo ""
            echo "Examples:"
            echo "  penv config list"
            echo "  penv config set default_python python3.11"
            echo "  penv config get storage_dir"
            ;;
        rename)
            echo "Usage: penv rename <old_name> <new_name>"
            echo ""
            echo "Rename a virtual environment."
            echo ""
            echo "Arguments:"
            echo "  old_name      Current name of the virtual environment"
            echo "  new_name      New name for the virtual environment"
            echo ""
            echo "This also updates activation markers and project bindings."
            echo ""
            echo "Example:"
            echo "  penv rename myproject myproject2"
            ;;
        doctor)
            echo "Usage: penv doctor"
            echo ""
            echo "Diagnose penv system health."
            echo ""
            echo "Checks dependencies (python3, expect, git), storage directory"
            echo "permissions, activation marker integrity, environment health,"
            echo "shell completion, systemd service, and configuration file."
            echo ""
            echo "Returns exit code 0 if no failures, 1 if any checks failed."
            echo ""
            echo "Example:"
            echo "  penv doctor"
            ;;
        prune)
            echo "Usage: penv prune [--force]"
            echo ""
            echo "Remove broken virtual environments."
            echo ""
            echo "An environment is considered broken if it is missing any of:"
            echo "  - Python interpreter (bin/python or bin/python3)"
            echo "  - pyvenv.cfg"
            echo "  - bin/activate"
            echo ""
            echo "Options:"
            echo "  --force       Skip confirmation prompt"
            echo ""
            echo "Example:"
            echo "  penv prune"
            echo "  penv prune --force"
            ;;
        plugin)
            echo "Usage: penv plugin [list]"
            echo ""
            echo "List installed plugins."
            echo ""
            echo "Plugins are executable .sh scripts placed in:"
            echo "  ~/.config/penv/plugins/"
            echo ""
            echo "The filename (without .sh) becomes the command name."
            echo ""
            echo "Example:"
            echo "  penv plugin list"
            ;;
        *)
            die "Unknown command: '$cmd'. Use 'penv help' to see available commands."
            ;;
    esac
}

if [ $# -eq 0 ]
then
    usage
fi

cmd=$1
case "$cmd" in
    create|list|remove|activate|show|deactivate|clean|clone|requirements|project|usage|info|config|rename|doctor|prune|plugin)
        script_path="${SCRIPT_DIR}/scripts/${SCRIPT_NAME}-${cmd}.sh"
        if [[ -f "$script_path" && -r "$script_path" && -x "$script_path" ]]; then
            "$script_path" "${@:2}"
        else
            die "Command script '$script_path' not found or not executable."
        fi
        ;;
    help|-h|--help)
        if [ $# -gt 1 ]; then
            command_help "${@:2}"
        else
            usage
        fi
        ;;
    --version)
        version
        ;;
    *)
        # Check plugin system before giving up
        penv_plugin_dir="${PENV_PLUGIN_DIR:-${HOME}/.config/penv/plugins}"
        if [[ -d "$penv_plugin_dir" ]]; then
            plugin_path="${penv_plugin_dir}/${cmd}.sh"
            if [[ -f "$plugin_path" && -x "$plugin_path" ]]; then
                "$plugin_path" "${@:2}"
                exit $?
            fi
        fi
        echo "The command '$cmd' is not supported."
        usage
        ;;
esac