#!/usr/bin/env bash
SCRIPT_PATH=$(realpath "$0")
SCRIPT_DIR=$(dirname "${SCRIPT_PATH}")
SCRIPT_NAME=$(basename "${SCRIPT_PATH}")

# Version information — sourced from VERSION file if present
VERSION_FILE="${SCRIPT_DIR}/VERSION"
if [[ -f "$VERSION_FILE" ]]; then
    VERSION=$(cat "$VERSION_FILE")
else
    VERSION="0.1.2"
fi

# Unified error handler
die() {
    echo "Error: $*" >&2
    exit 1
}

function usage()
{
    echo "Usage: ${SCRIPT_NAME} cmd [params]"
    echo ""
    echo "Python virtual environment management tool."
    echo ""
    echo "Commands:"
    echo ""
    echo "Lifecycle:"
    echo "  create        Creates a new virtual environment."
    echo "                Usage: penv create <env_name> [description]"
    echo "  clone         Clones a virtual environment to a new one."
    echo "                Usage: penv clone <source_env> <dest_env> [description]"
    echo "  rename        Rename a virtual environment."
    echo "                Usage: penv rename <old_name> <new_name>"
    echo "  remove        Removes a virtual environment."
    echo "                Usage: penv remove [env_name]"
    echo ""
    echo "Activation:"
    echo "  activate      Activates a virtual environment."
    echo "                Usage: penv activate [env_name]"
    echo "  deactivate    Deactivates the current virtual environment."
    echo "                Usage: penv deactivate"
    echo "  clean         Deactivates all virtual environments."
    echo "                Usage: penv clean"
    echo ""
    echo "Information:"
    echo "  list          Lists all virtual environments."
    echo "                Usage: penv list [--sort-by=name|date] [--json]"
    echo "  info          Show detailed information about an environment."
    echo "                Usage: penv info <env_name>"
    echo "  show          Show currently active environments."
    echo "                Usage: penv show"
    echo "  usage         Show disk usage of virtual environments."
    echo "                Usage: penv usage [--sort-by=size|name]"
    echo "  tree          Show package dependency tree."
    echo "                Usage: penv tree <env_name>"
    echo "  doctor        Diagnose penv system health."
    echo "                Usage: penv doctor"
    echo ""
    echo "Dependencies:"
    echo "  requirements  Export/import requirements for an environment."
    echo "                Usage: penv requirements <env_name> <export|import> [file]"
    echo ""
    echo "Project:"
    echo "  project       Bind projects to virtual environments."
    echo "                Usage: penv project <bind|unbind|show|list> [--direnv]"
    echo ""
    echo "Archive:"
    echo "  export        Archive a virtual environment to a tarball."
    echo "                Usage: penv export <env_name> [output_file]"
    echo "  import        Restore a virtual environment from archive."
    echo "                Usage: penv import <archive> [new_name]"
    echo ""
echo "Maintenance:"
                echo "  init          One-command setup (completion, profile, service)."
                echo "                Usage: penv init [--yes]"
                echo "  config        Manage penv configuration."
    echo "                Usage: penv config [list|get|set]"
    echo "  prune         Remove broken virtual environments."
    echo "                Usage: penv prune [--force]"
    echo "  upgrade       Self-update penv from GitHub."
    echo "                Usage: penv upgrade"
    echo "  plugin        List installed plugins."
    echo "                Usage: penv plugin [list]"
    echo ""
    echo "Other:"
    echo "  help, -h, --help    Displays this help message."
    echo "                Usage: penv help [command]"
    echo "  --version     Display version information."
    echo ""
    echo "Examples:"
    echo "  penv create myproject \"My Python project\""
    echo "  penv list"
    echo "  penv list --sort-by=date"
    echo "  penv activate myproject"
    echo "  penv deactivate"
    echo "  penv remove myproject"
    echo "  penv clone myproject newproject \"New project based on myproject\""
    echo "  penv requirements myproject export requirements.txt"
    echo "  penv requirements myproject import requirements.txt"
    echo "  penv project bind myproject"
    echo "  penv project bind myproject --direnv"
    echo "  penv usage --sort-by=size"
    echo "  penv info myproject"
    echo "  penv config set default_python python3.11"
    echo "  penv config list"
    echo "  penv rename myproject myproject2"
    echo "  penv doctor"
    echo "  penv prune"
    echo "  penv plugin list"
    echo "  penv tree myproject"
    echo "  penv export myproject myproject-venv.tar.gz"
    echo "  penv import myproject-venv.tar.gz"
    echo "  penv upgrade"
    echo "  penv init --yes"
    echo ""
    echo "For command-specific help, use: penv help <command>"
    exit 1
}

function version()
{
    echo "${SCRIPT_NAME} version ${VERSION}"
    exit 0
}

function command_help()
{
    if [ $# -eq 0 ]; then
        usage
        return
    fi

    local cmd=$1
    case "$cmd" in
        help|-h|--help)
            echo "Usage: penv help [command]"
            echo ""
            echo "Displays help for a specific command."
            echo "Use 'penv help' to see all commands, or 'penv help <command>' for details."
            ;;
        --version)
            echo "Usage: penv --version"
            echo ""
            echo "Display version information."
            ;;
        *)
            local script="${SCRIPT_DIR}/scripts/${SCRIPT_NAME}-${cmd}.sh"
            if [[ -f "$script" && -r "$script" && -x "$script" ]]; then
                "$script" --help
            else
                die "Unknown command: '$cmd'. Use 'penv help' to see available commands."
            fi
            ;;
    esac
}

if [ $# -eq 0 ]
then
    usage
fi

cmd=$1
case "$cmd" in
    create|list|remove|activate|show|deactivate|clean|clone|requirements|project|usage|info|config|rename|doctor|prune|plugin|tree|export|import|upgrade|init)
        script_path="${SCRIPT_DIR}/scripts/${SCRIPT_NAME}-${cmd}.sh"
        if [[ -f "$script_path" && -r "$script_path" && -x "$script_path" ]]; then
            "$script_path" "${@:2}"
        else
            die "Command script '$script_path' not found or not executable."
        fi
        ;;
    help|-h|--help)
        if [ $# -gt 1 ]; then
            command_help "${@:2}"
        else
            usage
        fi
        ;;
    --version)
        version
        ;;
    *)
        # Check plugin system before giving up
        penv_plugin_dir="${PENV_PLUGIN_DIR:-${HOME}/.config/penv/plugins}"
        if [[ -d "$penv_plugin_dir" ]]; then
            plugin_path="${penv_plugin_dir}/${cmd}.sh"
            if [[ -f "$plugin_path" && -x "$plugin_path" ]]; then
                "$plugin_path" "${@:2}"
                exit $?
            fi
        fi
        echo "The command '$cmd' is not supported."
        usage
        ;;
esac